{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuttlers-match-runtime-poc",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["python_workers"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
