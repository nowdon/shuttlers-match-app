{
  "name": "shuttlers-match-app",
  "main": "worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [
    {
      "type": "Data",
      "globs": ["**/*.csv", "**/*.png"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuttlers-match-app-prod",
      "database_id": "REPLACE_WITH_PRODUCTION_D1_UUID",
      "migrations_dir": "migrations/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HISTORY_ARCHIVES",
      "bucket_name": "shuttlers-match-history-prod"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["REPLACE_WITH_VERIFIED_SENDER"],
      "allowed_destination_addresses": ["REPLACE_WITH_VERIFIED_RECIPIENT"]
    }
  ],
  "vars": {
    "STORAGE_BACKEND": "d1",
    "HISTORY_ARCHIVE_BACKEND": "r2",
    "LINE_MESSAGING_ENABLED": "false",
    "MAIL_TRANSPORT": "cloudflare",
    "MAIL_FROM_EMAIL": "REPLACE_WITH_VERIFIED_SENDER"
  }
}
